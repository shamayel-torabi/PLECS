Plecs {
  Name          "phase_shift_dcdc_converter_with_integrated_magnetics"
  Version       "4.9"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "0.01"
  Timeout       ""
  Solver        "radau"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "5"
  ZCStepSize    "1e-9"
  RelTol        "1e-6"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "2"
  NegativeSwitchLossMsg "2"
  DivisionByZeroMsg "2"
  DatatypeOverflowMsg "2"
  DatatypeInheritanceConflictMsg "1"
  ContSampleTimeConflictMsg "1"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "2"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% Input/Output Voltages\nV_i = 48; \t% input voltage"
" (DC)\nV_o = 380; \t% output voltage target (DC)\n\n\n% Transformer\nN_p = 3;"
" % number of turns on primary side windings\nN_s = 24; % number of turns on s"
"econdary side windings\n\n% Load\nP_n = 2e3;\nR_o = V_o^2/P_n; % half rated p"
"ower\n\n% Modulator\nf_sw = 100e3; % switching frequency\n\n% Series inductan"
"ce of the transformer\nL_r = 10e-9;\n\n% Capacitor\nC_o = 47e-6;\n\nmu0 = 4*p"
"i*1e-7; \t% magnetic constant/permeability of free space (H/m)\nmurunsat = 18"
"70; \t% unsaturated relative permeability\nmursat = 6; \t\t% saturated relati"
"ve permeability\nBsat = 0.32; \t\t% flux density saturation\n\nareaside = 175"
".5e-6; % cross-sectional area of core side legs (m^2)\nareamid = 351e-6; \t% "
"cross-sectional area of core middle leg (m^2)\n% (2 cores are in parallel)\n"
"\nlengthcoreside = 46.275e-3; \t% length of flux path of side core leg (m)\nl"
"engthcoremid = 23.15e-3; \t\t% length of flux path of middle core leg (m)\nle"
"ngthgap = 3e-3; % length of flux path of all leg air gaps (m)\n\nRm1 = 1/(mu0"
"*murunsat)*lengthcoreside*2/(areaside); \t% reluctance of side leg of the cor"
"e\nRm2 = 1/(mu0*murunsat)*lengthcoremid*2/(areamid) \t\t% reluctance of middl"
"e leg of the core\nRm3 = Rm1; % reluctance of side leg of the core\n\nM = N_s"
"^2*Rm2/(Rm1*Rm2 + Rm1*Rm3 + Rm2*Rm3);\nL1 = N_s^2*(Rm2+Rm3)/(Rm1*Rm2 + Rm1*Rm"
"3 + Rm2*Rm3) - M;\nL2 = N_s^2*(Rm1+Rm2)/(Rm1*Rm2 + Rm1*Rm3 + Rm2*Rm3) - M;\n"
"\nLm_delta = (L1*L2 + L1*M + L2*M)/M*(N_p/N_s)^2; % equivalent magnetization "
"inductance at primary side\nL1_delta = (L1*L2 + L1*M + L2*M)/L2; % equivalent"
" output series inductance at secondary side\nL2_delta = (L1*L2 + L1*M + L2*M)"
"/L1; % equivalent output series inductance at secondary side\n\nL_o = L1_delt"
"a; % used in model gain controller parameter\n\n% Transformer winding resista"
"nce taking skin effect into account\nh_p_copper = 0.1e-3;\nh_p_total = 0.18e-"
"3;\nh_s_copper = 0.3e-3;\nh_s_total = 0.38e-3;\nsigma = 5.96e7;\nv_p = h_p_co"
"pper*sqrt(pi*mu0*sigma*f_sw);\nv_s = h_s_copper*sqrt(pi*mu0*sigma*f_sw);\nk_s"
"kin_p = v_p*(sinh(2*v_p) + sin(2*v_p))/(cosh(2*v_p)-cos(2*v_p));\nk_skin_s = "
"v_s*(sinh(2*v_s) + sin(2*v_s))/(cosh(2*v_s)-cos(2*v_s));\nl_p = ((22+32*2)*1e"
"-3*2*2+ 2*h_p_total*4*(N_p-1))*N_p/2;\ns_p = 36.5e-3*h_p_copper;\nl_s = (((22"
"+32*2)*1e-3*2 + 2*h_p_total*4*N_p)*2 + 2*h_s_total*4*(N_s-1))*N_s/2;\ns_s = 3"
"6.5e-3*h_s_copper;\nR_p = 1.68e-8*l_p/s_p*k_skin_p; % primary side equivalent"
" resistance\nR_s = 1.68e-8*l_s/s_s*k_skin_s; % secondary side equivalent resi"
"stance"
  InitialState  "1"
