      MaskInit      "if(~isempty(Therm.Von))\n"
"\tTherm.Von.i = Therm.Von.i*num_par;\n"
"\tTherm.Von.v = Therm.Von.v*num_ser;\n"
"end\n"
"\n"
"if(~isempty(Therm.Eon))\n"
"\tTherm.Eon.v = Therm.Eon.v*num_ser;\n"
"\tTherm.Eon.i = Therm.Eon.i*num_par;\n"
"\tTherm.Eon.E = Therm.Eon.E*num_par*num_ser;\n"
"end\n"
"\n"
"if(~isempty(Therm.Eoff))\n"
"\tTherm.Eoff.v = Therm.Eoff.v*num_ser;\n"
"\tTherm.Eoff.i = Therm.Eoff.i*num_par;\n"
"\tTherm.Eoff.E = Therm.Eoff.E*num_par*num_ser;\n"
"end\n"
"\n"
"if(~isempty(Therm.CauerChain))\n"
"\tTherm.CauerChain.R = Therm.CauerChain.R/(num_par*num_ser);\n"
"\tTherm.CauerChain.C = Therm.CauerChain.C*num_par*num_ser;\n"
"end"
