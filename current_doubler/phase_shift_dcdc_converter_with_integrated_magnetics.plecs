Plecs {
  Name          "phase_shift_dcdc_converter_with_integrated_magnetics"
  Version       "4.9"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "0.1"
  Timeout       ""
  Solver        "radau"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "5"
  ZCStepSize    "1e-9"
  RelTol        "1e-6"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "2"
  DivisionByZeroMsg "2"
  DatatypeOverflowMsg "2"
  DatatypeInheritanceConflictMsg "1"
  ContSampleTimeConflictMsg "1"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "2"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% Input/Output Voltages\nV_i = 48; % input voltage ("
"DC)\nV_o_max = 400; % maximum output voltage target (DC)\nV_o_min = 360; % mi"
"nimum output voltage target (DC)\n\n% Transformer\nN_p = 25; % number of turn"
"s on primary side windings\nN_s = 75; % number of turns on secondary side win"
"dings\n\nmu0 = 4*pi*1e-7; % magnetic constant/permeability of free space (H/m"
")\nmurunsat = 6500; % unsaturated relative permeability\nmursat = 6; % satura"
"ted relative permeability\nBsat = 0.49; % flux density saturation\n\nareaside"
" = 360e-6*2; % cross-sectional area of core side legs (m^2)\nareamid = 704e-6"
"*2; % cross-sectional area of core middle leg (m^2)\n% (2 cores are in parall"
"el)\n\nlengthcoreside = 57.2e-3; % length of flux path of side core leg (m)\n"
"lengthcoremid = 26e-3; % length of flux path of middle core leg (m)\nlengthga"
"p = 3e-3; % length of flux path of all leg air gaps (m)\n\nRm1 = 1/(mu0*murun"
"sat)*lengthcoreside*2/(areaside) + 1/mu0*lengthgap/(areaside); % reluctance o"
"f side leg of the core\nRm2 = 1/(mu0*murunsat)*lengthcoremid*2/(areamid) + 1/"
"mu0*lengthgap/(areamid); % reluctance of middle leg of the core\nRm3 = Rm1; %"
" reluctance of side leg of the core\n\nM = N_s^2*Rm2/(Rm1*Rm2 + Rm1*Rm3 + Rm2"
"*Rm3);\nL1 = N_s^2*(Rm2+Rm3)/(Rm1*Rm2 + Rm1*Rm3 + Rm2*Rm3) - M;\nL2 = N_s^2*("
"Rm1+Rm2)/(Rm1*Rm2 + Rm1*Rm3 + Rm2*Rm3) - M;\n\nLm_delta = (L1*L2 + L1*M + L2*"
"M)/M*(N_p/N_s)^2; % equivalent magnetization inductance at primary side\nL1_d"
"elta = (L1*L2 + L1*M + L2*M)/L2; % equivalent output series inductance at sec"
"ondary side\nL2_delta = (L1*L2 + L1*M + L2*M)/L1; % equivalent output series "
"inductance at secondary side\n\nL_o = L1_delta; % used in model gain controll"
"er parameter\n\n% Capacitor\nC_o = 30e-6;\n\n% Load\nP_n = 5e3;\nR_o = V_o_mi"
"n^2/P_n*2; % half rated power\n\n% Modulator\nf_sw = 20e3; % switching freque"
"ncy\n\n% Transformer winding resistance taking skin effect into account\nh_p_"
"copper = 0.1e-3;\nh_p_total = 0.18e-3;\nh_s_copper = 0.3e-3;\nh_s_total = 0.3"
"8e-3;\nsigma = 5.96e7;\nv_p = h_p_copper*sqrt(pi*mu0*sigma*f_sw);\nv_s = h_s_"
"copper*sqrt(pi*mu0*sigma*f_sw);\nk_skin_p = v_p*(sinh(2*v_p) + sin(2*v_p))/(c"
"osh(2*v_p)-cos(2*v_p));\nk_skin_s = v_s*(sinh(2*v_s) + sin(2*v_s))/(cosh(2*v_"
"s)-cos(2*v_s));\nl_p = ((22+32*2)*1e-3*2*2+ 2*h_p_total*4*(N_p-1))*N_p/2;\ns_"
"p = 36.5e-3*h_p_copper;\nl_s = (((22+32*2)*1e-3*2 + 2*h_p_total*4*N_p)*2 + 2*"
"h_s_total*4*(N_s-1))*N_s/2;\ns_s = 36.5e-3*h_s_copper;\nR_p = 1.68e-8*l_p/s_p"
"*k_skin_p; % primary side equivalent resistance\nR_s = 1.68e-8*l_s/s_s*k_skin"
"_s; % secondary side equivalent resistance\n\n% Series inductance of the tran"
"sformer\nL_r = 3e-6;"
  InitialState  "1"
