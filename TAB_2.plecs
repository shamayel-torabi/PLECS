  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "2"
  DatatypeInheritanceConflictMsg "1"
  ContSampleTimeConflictMsg "1"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "Vi = 400;\nVo = 400;\nCdc = 100e-6;\nRdc = 1e-3;\n\n"
"fsw = 35e3;\nTsw = 1/fsw;\n\nLk = 5e-6;\n\n%% Device Parameter\nRon = 0.045;"
"\nCoss = 1e-7;\nRcap = 1e-4;\n%% Thermal \nTabm = 25;\nPS1 = 0;\nPS2 = 0.0265"
"*1;\n\n% Transformer\nN_p = 25; % number of turns on primary side windings\nN"
"_s = 25; % number of turns on secondary side windings\nN=50;\nmu0 = 4*pi*1e-7"
"; % magnetic constant/permeability of free space (H/m)\nmurunsat = 6500; % un"
"saturated relative permeability\nmursat = 6; % saturated relative permeabilit"
"y\nBsat = 0.49; % flux density saturation\n\nareaside = 360e-6*2; % cross-sec"
"tional area of core side legs (m^2)\nareamid = 704e-6*2; % cross-sectional ar"
"ea of core middle leg (m^2)\n% (2 cores are in parallel)\n\nlengthcoreside = "
"57.2e-3; % length of flux path of side core leg (m)\nlengthcoremid = 26e-3; %"
" length of flux path of middle core leg (m)\nlengthgap = 3e-3; % length of fl"
"ux path of all leg air gaps (m)"
